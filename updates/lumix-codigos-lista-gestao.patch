new file mode 100644
index 0000000..ee15718
--- /dev/null
+++ b/frontend/src/lib/code128.js
@@ -0,0 +1,47 @@
+// Gera código de barras Code 128 (conjunto B) como SVG, sem bibliotecas.
+// Lido por qualquer leitor/câmera; o texto lido é exatamente o texto codificado.
+const PATTERNS = [
+  '212222', '222122', '222221', '121223', '121322', '131222', '122213', '122312', '132212', '221213',
+  '221312', '231212', '112232', '122132', '122231', '113222', '123122', '123221', '223211', '221132',
+  '221231', '213212', '223112', '312131', '311222', '321122', '321221', '312212', '322112', '322211',
+  '212123', '212321', '232121', '111323', '131123', '131321', '112313', '132113', '132311', '211313',
+  '231113', '231311', '112133', '112331', '132131', '113123', '113321', '133121', '313121', '211331',
+  '231131', '213113', '213311', '213131', '311123', '311321', '331121', '312113', '312311', '332111',
+  '314111', '221411', '431111', '111224', '111422', '121124', '121421', '141122', '141221', '112214',
+  '112412', '122114', '122411', '142112', '142211', '241211', '221114', '413111', '241112', '134111',
+  '111242', '121142', '121241', '114212', '124112', '124211', '411212', '421112', '421211', '212141',
+  '214121', '412121', '111143', '111341', '131141', '114113', '114311', '411113', '411311', '113141',
+  '114131', '311141', '411131', '211412', '211214', '211232', '2331112',
+];
+const START_B = 104;
+const STOP = 106;
+
+/** Sequência de larguras (barra, espaço, barra, ...) em módulos. */
+export const code128Widths = (text) => {
+  const values = [...String(text)].map((ch) => {
+    const v = ch.charCodeAt(0) - 32;
+    if (v < 0 || v > 94) throw new Error('Caractere não suportado no código de barras');
+    return v;
+  });
+  const checksum = values.reduce((sum, v, i) => sum + v * (i + 1), START_B) % 103;
+  return [START_B, ...values, checksum, STOP].flatMap((v) => PATTERNS[v].split('').map(Number));
+};
+
+/** SVG do código (com margem silenciosa e o texto embaixo). */
+export const code128Svg = (text, { height = 40, module = 1.4, showText = true } = {}) => {
+  const widths = code128Widths(text);
+  const quiet = 10;
+  const total = widths.reduce((a, w) => a + w, 0) + quiet * 2;
+  let x = quiet;
+  let bars = '';
+  widths.forEach((w, i) => {
+    if (i % 2 === 0) bars += `<rect x="${x}" y="0" width="${w}" height="${height / module}"/>`;
+    x += w;
+  });
+  const textH = showText ? 12 : 0;
+  const esc = String(text).replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]));
+  return `<svg xmlns="http://www.w3.org/2000/svg" width="${total * module}" height="${height + textH}" viewBox="0 0 ${total} ${height / module + textH / module}" shape-rendering="crispEdges">`
+    + `<rect width="100%" height="100%" fill="#fff"/><g fill="#000">${bars}</g>`
+    + (showText ? `<text x="${total / 2}" y="${(height + 10) / module}" font-family="monospace" font-size="${9 / module}" text-anchor="middle">${esc}</text>` : '')
+    + '</svg>';
+};
