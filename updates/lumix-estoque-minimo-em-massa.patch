+class MinimumUpdate(BaseModel):
+    product_id: str
+    minimums: Dict[str, int] = Field(default_factory=dict)  # 0 remove o mínimo
+    add_sizes: List[str] = Field(default_factory=list)       # marca o tamanho como "Tem"
+
