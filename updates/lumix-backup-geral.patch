+    def __init__(self, sync_db):
+        self.sync = sync_db
+
+    async def list_collection_names(self):
+        return self.sync.list_collection_names()
+
+    def __getitem__(self, name):
+        return AsyncColl(self.sync[name])
+
+    __getattr__ = __getitem__
